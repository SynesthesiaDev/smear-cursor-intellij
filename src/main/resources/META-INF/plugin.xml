<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>moe.syndev.smearcursor</id>
    <name>Smear Cursor</name>
    <vendor email="syn@syndev.moe" url="https://syndev.moe/">Smear Cursor</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        
        <postStartupActivity implementation="com.smearcursor.SmearCursorStartupActivity"/>

        <applicationConfigurable
                parentId="editor"
                instance="com.smearcursor.settings.SmearCursorConfigurable"
                id="com.smearcursor.settings"
                displayName="Smear Cursor"
        />
        
    </extensions>

    <actions>
        <action id="SmearCursor.Toggle"
                class="com.smearcursor.actions.ToggleSmearCursorAction"
                text="Toggle Smear Cursor"
                description="Enable or disable smear cursor animation">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
